# Configuration for custom termux package generator
TERMUX_APP_PACKAGE="com.agentdesk.app"
TERMUX_APP_NAME="AgentDesk"
TERMUX_PREFIX="/data/data/com.agentdesk.app/files/usr"
TERMUX_ANDROID_HOME="/data/data/com.agentdesk.app/files/home"
TERMUX_ARCH="aarch64"
BOOTSTRAP_PACKAGES="bash,coreutils,apt,dpkg,proot,curl,ca-certificates,tar,xz-utils,gzip,unzip"
