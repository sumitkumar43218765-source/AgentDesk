{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "rootfs-ubuntu",
      "name": "Ubuntu Rootfs",
      "description": "Ubuntu 22.04 LTS aarch64 base environment for proot",
      "category": "CORE",
      "required": true,
      "dependsOn": [],
      "sizeEstimateMb": 800,
      "environment": "TERMUX_NATIVE",
      "source": {
        "kind": "APT",
        "packages": ["proot", "tar", "curl", "xz-utils"]
      },
      "install": [
        "apt-get update",
        "apt-get install -y proot tar curl xz-utils"
      ],
      "verify": "cat /etc/os-release 2>/dev/null || [ -f \"$AGENTDESK_ROOTFS/etc/os-release\" ]",
      "version": "22.04"
    },
    {
      "id": "jdk-17",
      "name": "Java JDK 17",
      "description": "Needed by ecj, d8 and apksigner",
      "category": "CORE",
      "required": true,
      "dependsOn": ["rootfs-ubuntu"],
      "sizeEstimateMb": 300,
      "environment": "PROOT_UBUNTU",
      "source": {
        "kind": "APT",
        "packages": ["openjdk-17-jdk-headless"]
      },
      "install": [
        "apt-get update",
        "apt-get install -y openjdk-17-jdk-headless"
      ],
      "verify": "java -version",
      "version": "17"
    },
    {
      "id": "android-sdk-min",
      "name": "Android SDK Build Tools",
      "description": "android.jar platform, aapt2, d8, zipalign, apksigner",
      "category": "CORE",
      "required": true,
      "dependsOn": ["jdk-17"],
      "sizeEstimateMb": 500,
      "environment": "PROOT_UBUNTU",
      "source": {
        "kind": "APT",
        "packages": ["aapt", "zipalign"]
      },
      "install": [
        "apt-get update",
        "apt-get install -y aapt zipalign || true"
      ],
      "verify": "aapt version 2>/dev/null || aapt2 version 2>/dev/null || true",
      "version": "34.0.0"
    },
    {
      "id": "ecj",
      "name": "Eclipse Compiler for Java (ECJ)",
      "description": "Java compiler for compiling Android app source on ARM64",
      "category": "CORE",
      "required": true,
      "dependsOn": ["jdk-17"],
      "sizeEstimateMb": 20,
      "environment": "PROOT_UBUNTU",
      "source": {
        "kind": "APT",
        "packages": ["ecj"]
      },
      "install": [
        "apt-get update",
        "apt-get install -y ecj"
      ],
      "verify": "ecj -version 2>/dev/null || javac -version",
      "version": "3.28"
    },
    {
      "id": "git",
      "name": "Git",
      "description": "Version control for project tracking and history",
      "category": "CORE",
      "required": true,
      "dependsOn": ["rootfs-ubuntu"],
      "sizeEstimateMb": 50,
